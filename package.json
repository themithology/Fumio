{
  "name": "fumio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fumio — movies, series and anime in one fast, clean app. Skeleton build: minimal browse/details/player UI, Iris's TMDB data proxy, and a pluggable raw-stream provider layer with real quality + audio track selection.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-router-dom": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.15",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.15",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  }
}
