{
  "appId": "com.fumio.app",
  "appName": "TheOGPirateBot",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "theogpiratebot.to",
      "*.theogpiratebot.to",
      "theogpiratebot.online",
      "*.theogpiratebot.online"
    ]
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
